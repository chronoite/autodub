# AutoDub configuration. Every setting is optional; the defaults are shown or described.
# AutoDub reads real environment variables — load this file with your shell or process manager.

# Where jobs, uploads, outputs, voice references and logs are stored (default: <repo>/data)
# AUTODUB_HOME=C:\autodub-data

# Where model weights live (default: <repo>/models). scripts/download_models.py fills this.
# AUTODUB_MODELS_DIR=C:\autodub-models

# Web UI (loopback only; non-loopback binds are refused)
# AUTODUB_HOST=127.0.0.1
# AUTODUB_PORT=8030

# External tools (default: found on PATH)
# AUTODUB_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
# AUTODUB_FFPROBE=C:\tools\ffmpeg\bin\ffprobe.exe
# AUTODUB_KOBOLDCPP=C:\tools\koboldcpp\koboldcpp.exe

# Worker interpreters — one virtual environment per model family. MEDIA defaults to the
# interpreter running AutoDub; the others default to MEDIA. See docs/SETUP.md.
# AUTODUB_PYTHON_MEDIA=C:\envs\autodub-media\Scripts\python.exe
# AUTODUB_PYTHON_ANALYSIS=C:\envs\autodub-analysis\Scripts\python.exe
# AUTODUB_PYTHON_QUALITY=C:\envs\autodub-tts\Scripts\python.exe
# AUTODUB_PYTHON_CHATTERBOX=
# AUTODUB_PYTHON_COSYVOICE=
# AUTODUB_COSYVOICE_SOURCE=<repo>/third_party/CosyVoice
# AUTODUB_COSYVOICE_EXTRA_SITE=

# Optional extra site-packages for CPU workers (pip install --target); ignored if absent
# AUTODUB_RUNTIME_DEPS=<repo>/runtime_deps

# GPU coordination (docs/GPU-COORDINATION.md)
# AUTODUB_GPU_BROKER_URL=http://127.0.0.1:8765
# AUTODUB_ADAPT_PORT=5031
# AUTODUB_ADAPT_CONFLICT_PORTS=5001   # e.g. your own LLM server that would compete for VRAM

# Thermal guard for the episode queue (default: on, reads nvidia-smi)
# AUTODUB_THERMAL_GUARD=1
# AUTODUB_GPU_TEMP_COMMAND=

# Optional GPT-SoVITS clone service
# AUTODUB_GPT_SOVITS_URL=http://127.0.0.1:9880
